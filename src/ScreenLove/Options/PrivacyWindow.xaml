<Window x:Class="ScreenLove.Options.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenLove" Width="520" SizeToContent="Height"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" ResizeMode="NoResize" ShowInTaskbar="True">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="10,8"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Click="Confirm_Click" HorizontalAlignment="Right" IsDefault="True"/>
        </Border>

        <StackPanel Margin="24,20,24,18">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="IntroText" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19"/>

            <CheckBox x:Name="StatsBox" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="StatsTitle" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatsDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="ErrorsBox" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="ErrorsTitle" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ErrorsDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </CheckBox>

            <TextBlock x:Name="LocalText" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="19"/>
            <TextBlock x:Name="DownloadsText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
    </DockPanel>
</Window>

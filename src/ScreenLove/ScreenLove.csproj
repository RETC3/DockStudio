<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+: serve per le API WinRT (OCR di Windows) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Company>ScreenLove</Company>
    <Description>ScreenLove — cattura dello schermo</Description>
    <RootNamespace>ScreenLove</RootNamespace>
    <AssemblyName>ScreenLove</AssemblyName>
    <Product>ScreenLove</Product>
    <Version>0.1.0</Version>
    <!-- Il DPI è dichiarato nel manifest: l'host è WPF, non WinForms -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Memoria: le istantanee dello schermo sono oggetti grandi. ConserveMemory fa compattare la loro
         area quando è frammentata, invece di farla crescere (vedi anche Services/MemoryRelief.cs). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nucleo comune delle app DockStudio -->
    <ProjectReference Include="..\DockStudio.Core\DockStudio.Core.csproj" />
    <ProjectReference Include="..\DockStudio.Core.Windows\DockStudio.Core.Windows.csproj" />
    <ProjectReference Include="..\DockStudio.Imaging\DockStudio.Imaging.csproj" />
    <ProjectReference Include="..\DockStudio.Documents\DockStudio.Documents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lettura di codici QR e a barre (Apache 2.0) -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <!-- Cattura audio WASAPI (sistema in loopback + microfono), MIT -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generatore di documenti condiviso (Windows e macOS): manuali e guide in PDF, Word e HTML
       da una serie di immagini con titolo e commento. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <RootNamespace>DockStudio.Documents</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF (MIT) e Word .docx (MIT) -->
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DockStudio.Core\DockStudio.Core.csproj" />
    <ProjectReference Include="..\DockStudio.Imaging\DockStudio.Imaging.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Controlli di DockPDF: motore (lettura, composizione, divisione, password, immagini) e finestre disegnate
       senza schermo (Avalonia headless) in italiano e inglese, chiare e scure.
       Esecuzione: dotnet run con il progetto tests/DockPDF.Checks e, facoltativa, la cartella delle immagini. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DockPDF\DockPDF.csproj" />
    <ProjectReference Include="..\..\src\DockStudio.Documents\DockStudio.Documents.csproj" />
  </ItemGroup>

</Project>

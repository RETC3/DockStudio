<Project Sdk="Microsoft.NET.Sdk">

  <!-- Controlli di DockPost: motore (provider, archivio, ricerca, lettura sicura dell'HTML, risposte e invio
       composto) e finestre disegnate senza schermo (Avalonia headless) in italiano e inglese, chiare e scure.
       Esecuzione: dotnet run con il progetto tests/DockPost.Checks e, facoltativa, la cartella delle immagini. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DockPost\DockPost.csproj" />
  </ItemGroup>

</Project>

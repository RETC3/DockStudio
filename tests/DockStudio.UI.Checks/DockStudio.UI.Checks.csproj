<Project Sdk="Microsoft.NET.Sdk">

  <!-- Controlli dell'interfaccia comune DockStudio.UI senza schermo (Avalonia headless): ogni finestra viene
       disegnata in italiano e in inglese, chiara e scura, e salvata come PNG da guardare.
       Esecuzione: dotnet run con il progetto tests/DockStudio.UI.Checks e la cartella delle immagini. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DockStudio.UI\DockStudio.UI.csproj" />
  </ItemGroup>

</Project>
